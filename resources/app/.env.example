# ============================================
# Labra Configuration - Environment Variables
# ============================================
# Copy this file to .env and fill in your values.
# 
# IMPORTANT: Secrets (DSN, SECRET_KEY, CENTRIFUGO_API_KEY) are managed via Infisical.
# See docs/secrets-management.md for setup instructions.
# ============================================

# ============================================
# NON-SENSITIVE CONFIGURATION
# ============================================

# Database dialect: sqlite, postgres, or mysql
DB_DIALECT=postgres

# Server port (default: 4000)
SERVER_PORT=4000

# Path to ent schema files (default: ./ent/schema)
ENT_SCHEMA_PATH=./ent/schema

# Centrifugo API address (for real-time subscriptions)
CENTRIFUGO_API_ADDRESS=http://localhost:8000/api

# File storage provider: local (default) or s3
FILE_STORAGE_PROVIDER=local

# Path for local file storage (default: ./storage)
FILE_STORAGE_PATH=./storage

# Application environment (maps to Infisical environment): dev, staging, or prod
APP_ENVIRONMENT=dev

# ============================================
# INFISICAL CONFIGURATION (for secrets)
# ============================================
# These credentials authenticate with Infisical to fetch secrets at runtime.
# 
# To use the env fallback instead of Infisical (for testing):
#   - Leave INFISICAL_* variables empty
#   - Set DSN, SECRET_KEY, CENTRIFUGO_API_KEY directly (not recommended for production)

# Machine Identity Client ID (from Infisical dashboard)
INFISICAL_CLIENT_ID=

# Machine Identity Client Secret (from Infisical dashboard)
INFISICAL_CLIENT_SECRET=

# Project ID (from Infisical project settings)
INFISICAL_PROJECT_ID=

# Optional: Custom Infisical instance URL (default: https://app.infisical.com)
# INFISICAL_SITE_URL=https://app.infisical.com

# ============================================
# FALLBACK: DIRECT SECRETS (Testing/Legacy Only)
# ============================================
# WARNING: Only use these for local testing when Infisical is not configured.
# For production, always use Infisical for secrets management.
#
# These are only read if INFISICAL_CLIENT_ID is not set.

# Database connection string
# DSN=postgres://user:password@localhost:5432/labra?sslmode=disable

# JWT signing secret (minimum 16 characters)
# SECRET_KEY=your-super-secret-jwt-key-here

# Centrifugo API key
# CENTRIFUGO_API_KEY=your-centrifugo-api-key

# Comma-separated allowed origins for CORS. Do NOT use '*' when credentials are enabled.
CORS_ALLOWED_ORIGINS=http://localhost:3000


# Content Security Policy (override per deployment if needed)
CSP_POLICY="default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-ancestors 'none'"

# Rate limiting (per-IP)
# /login  -> 10 requests/minute per IP
AUTH_LOGIN_RATE_LIMIT_RPM=10

# /signup -> 5 requests/minute per IP
AUTH_SIGNUP_RATE_LIMIT_RPM=5

# General authenticated endpoints (GraphQL + protected routes)
AUTH_API_RATE_LIMIT_RPM=100

# Access token lifetime in minutes (default: 15)
ACCESS_TOKEN_TTL_MINUTES=15

# Refresh token lifetime in hours (default: 168 = 7 days)
REFRESH_TOKEN_TTL_HOURS=168
