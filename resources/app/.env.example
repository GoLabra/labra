# LabraGo Backend Environment Variables
# Copy this file to .env and update the values for your environment

# Database Configuration
# PostgreSQL connection string in DSN format
# Format: postgres://user:password@host:port/database?sslmode=disable
# Example: postgres://postgres:postgres@localhost:5432/labrago?sslmode=disable
DSN=postgres://postgres:postgres@localhost:5432/labrago?sslmode=disable

# Database dialect (currently only postgres is supported)
DB_DIALECT=postgres

# Server Configuration
# Port on which the GraphQL API server will listen
# Default: 4000 (if not specified)
SERVER_PORT=4000

# Schema Configuration
# Path to the Ent schema directory (relative to the app directory)
# Default: ./ent/schema (if not specified)
ENT_SCHEMA_PATH=./ent/schema

# Security
# Secret key used for JWT token signing and encryption
# Generate a secure key with: head -c 32 /dev/urandom | base64
# REQUIRED: Replace this with your own generated secret key
SECRET_KEY=XyZ7WpPqY2VW3m1O9QkH1fLj8zT6sJgKAsDfGhJ7K0I=

# Centrifugo Configuration
# Address of the Centrifugo API server (used for real-time subscriptions)
CENTRIFUGO_API_ADDRESS=http://localhost:8000/api

# Centrifugo API key for authentication
# Generate a secure key with: head -c 32 /dev/urandom | base64
# REQUIRED: Replace this with your own generated secret key
CENTRIFUGO_API_KEY=m4Q9KvJNpY8Gh2LxU7sR0cVf3eZUw1PnKaYtXjBmOq0=

# File Storage Configuration
# Storage provider to use for file uploads
# Valid values: local (currently implemented), S3, GCS (future support)
# Default: local (if not specified)
FILE_STORAGE_PROVIDER=local

# File storage path (directory where uploaded files will be stored)
# Can be relative (e.g., ./storage) or absolute (e.g., /var/lib/labrago/storage)
# Directory must exist and be writable by the application
# Recommended permissions: 0755 for directory, 0644 for files
# Default: ./storage (if not specified)
FILE_STORAGE_PATH=./storage
