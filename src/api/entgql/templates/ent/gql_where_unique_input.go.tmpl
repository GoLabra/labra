	return q.Where(p), nil
}

func (i *{{$n.Name}}WhereUniqueInput) P() (predicate.{{$n.Name}}, error) {
	var predicates []predicate.{{$n.Name}}

	if i.ID != nil {
		predicates = append(predicates, {{$n.Name | ToLower}}.IDEQ(*i.ID))
	}

	{{- range $f := $n.Fields}}
