{{- define "edge"}}
        edge.{{ if eq $.Edge.Ref "" }}To{{ else }}From{{end}}("{{$.Edge.EntName}}", {{$.Edge.Type}}.Type).
            {{- if and ($.Edge.Required | IsTrue) (eq $.Edge.Ref "") }}
            Required().
            {{- end}}
            {{- if ne $.Edge.Ref "" }}
            Ref("{{ $.Edge.Ref }}").
            {{- end}}
            {{- if  or (eq $.Edge.RelationType "OneToOne") (eq $.Edge.RelationType "ManyToOne") (eq $.Edge.RelationType "One")}}
            Unique().
            {{- end }}
            Annotations(
                entgql.Skip(entgql.SkipMutationCreateInput, entgql.SkipMutationUpdateInput),
				annotations.Edge{
					Caption:      "{{$.Edge.Caption}}",
                    RelationType: entity.RelationType{{$.Edge.RelationType.VariableName}},
				},
            {{- if eq $.Ref nil}}
            ),
            {{- else}}
            ).
            From("{{$.Ref.EntName}}").
            {{- if $.Ref.Required | IsTrue  }}
            Required().
            {{- end}}
            {{- if  or (eq $.Ref.RelationType "O2O") (eq $.Ref.RelationType "O2M") (eq $.Ref.RelationType "One")}}
            Unique().
            {{- end }}
			Annotations(
                entgql.Skip(entgql.SkipMutationCreateInput, entgql.SkipMutationUpdateInput),
				annotations.Edge{
					Caption:      "{{$.Ref.Caption}}",
                    RelationType: entity.RelationType{{$.Edge.RelationType.VariableName}},
				},
			),
            {{- end}}
{{- end}}